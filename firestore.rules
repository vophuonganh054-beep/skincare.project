rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connectivity test document
    match /test/{docId} {
      allow read: if true;
    }

    // User Profile Validation & Security
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.keys().hasAll(['userId', 'name', 'email']) &&
        data.keys().hasOnly(['userId', 'name', 'email', 'phone', 'address', 'tier', 'points', 'avatarInitials', 'photoURL', 'createdAt', 'updatedAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 30)) &&
        (!('address' in data) || (data.address is string && data.address.size() <= 300)) &&
        (!('tier' in data) || (data.tier is string && data.tier.size() <= 100)) &&
        (!('points' in data) || (data.points is number && data.points >= 0)) &&
        (!('avatarInitials' in data) || (data.avatarInitials is string && data.avatarInitials.size() <= 20)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 60)) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 60));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (request.auth == null || request.auth.uid == userId);
      allow list: if false; // Blanket user listing forbidden to prevent PII scraping

      allow create: if isValidId(userId) && (request.auth == null || request.auth.uid == userId) && isValidUserProfile(incoming(), userId);

      allow update: if isValidId(userId) && (request.auth == null || request.auth.uid == userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'address', 'tier', 'points', 'avatarInitials', 'photoURL', 'updatedAt']);

      allow delete: if false;

      // Scoped User Orders Subcollection
      match /orders/{orderId} {
        allow get: if isValidId(userId) && isValidId(orderId) && (request.auth == null || request.auth.uid == userId);
        allow list: if isValidId(userId) && (request.auth == null || request.auth.uid == userId);

        allow create: if isValidId(userId) && isValidId(orderId) && (request.auth == null || request.auth.uid == userId) &&
          incoming().userId == userId &&
          incoming().keys().hasAll(['id', 'orderNumber', 'userId', 'createdAt', 'totalAmount', 'status', 'items']) &&
          incoming().id is string && incoming().id.size() <= 128 &&
          incoming().orderNumber is string && incoming().orderNumber.size() <= 50 &&
          incoming().totalAmount is number && incoming().totalAmount >= 0 &&
          incoming().status in ['processing', 'shipping', 'delivered', 'completed'] &&
          incoming().items is list && incoming().items.size() > 0 && incoming().items.size() <= 50;

        allow update: if isValidId(userId) && isValidId(orderId) && (request.auth == null || request.auth.uid == userId) &&
          existing().status == 'processing' &&
          incoming().userId == existing().userId &&
          incoming().totalAmount == existing().totalAmount &&
          incoming().diff(existing()).affectedKeys().hasOnly(['buyerName', 'phone', 'shippingAddress', 'note', 'updatedAt']) &&
          (!('buyerName' in incoming()) || (incoming().buyerName is string && incoming().buyerName.size() <= 100)) &&
          (!('phone' in incoming()) || (incoming().phone is string && incoming().phone.size() <= 30)) &&
          (!('shippingAddress' in incoming()) || (incoming().shippingAddress is string && incoming().shippingAddress.size() <= 300));

        allow delete: if false;
      }
    }

    // Public Product Reviews Collection
    function isValidReview(data, authorUid) {
      return data.userId == authorUid &&
        data.keys().hasAll(['id', 'productId', 'userId', 'authorName', 'rating', 'comment', 'date']) &&
        data.keys().hasOnly(['id', 'productId', 'userId', 'authorName', 'rating', 'comment', 'date', 'skinType', 'title', 'isVerifiedBuyer', 'helpfulCount']) &&
        data.id is string && data.id.size() <= 128 &&
        data.productId is string && data.productId.size() <= 50 &&
        data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() > 0 && data.comment.size() <= 1500 &&
        data.date is string && data.date.size() <= 60 &&
        (!('skinType' in data) || (data.skinType is string && data.skinType.size() <= 50)) &&
        (!('title' in data) || (data.title is string && data.title.size() <= 150)) &&
        (!('isVerifiedBuyer' in data) || data.isVerifiedBuyer is bool) &&
        (!('helpfulCount' in data) || (data.helpfulCount is number && data.helpfulCount >= 0));
    }

    match /reviews/{reviewId} {
      allow get: if isValidId(reviewId);
      allow list: if true;

      allow create: if isSignedIn() && isValidId(reviewId) &&
        isValidReview(incoming(), request.auth.uid);

      allow update: if isSignedIn() && isValidId(reviewId) && (
        // Action 1: Author updates their own review
        (existing().userId == request.auth.uid &&
         isValidReview(incoming(), request.auth.uid) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'title', 'comment', 'skinType', 'date'])) ||
        // Action 2: Any signed in user votes helpful (increments helpful count)
        (incoming().diff(existing()).affectedKeys().hasOnly(['helpfulCount']) &&
         incoming().helpfulCount is number &&
         incoming().helpfulCount >= 0)
      );

      allow delete: if isSignedIn() && isValidId(reviewId) && existing().userId == request.auth.uid;
    }

    // User Personalized Shopping Cart
    match /carts/{userId} {
      allow get: if isValidId(userId) && (request.auth == null || request.auth.uid == userId);
      allow list: if false;

      allow create, update: if isValidId(userId) && (request.auth == null || request.auth.uid == userId) &&
        incoming().keys().hasOnly(['items', 'updatedAt']) &&
        incoming().items is list && incoming().items.size() <= 50;

      allow delete: if isValidId(userId) && (request.auth == null || request.auth.uid == userId);
    }
  }
}
