# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# CỔNG THANH TOÁN TỰ ĐỘNG SEPAY & MB BANK (VIETQR NAPAS 247)
# ==============================================================================
# Trạng thái kích hoạt thanh toán thật:
# - PAYMENTS_ENABLED="false": Chế độ Thử nghiệm (Mặc định). Cho phép mô phỏng thanh toán, không trừ tiền thật.
# - PAYMENTS_ENABLED="true": Chỉ bật khi bạn muốn kết nối nhận tiền thật qua SePay Webhook.
PAYMENTS_ENABLED="false"

# Số tài khoản MB Bank đã liên kết trên SePay (BẮT BUỘC khi chạy thật - giữ số 0 đầu, không dấu cách)
SEPAY_ACCOUNT_NUMBER="0772770134"

# Tên viết tắt ngân hàng (Mặc định: MB)
SEPAY_BANK_NAME="MB"

# Tên chủ tài khoản MB Bank hiển thị trên mã QR (Mặc định: ALPS)
SEPAY_ACCOUNT_NAME="ALPS"

# Khóa bí mật xác thực Webhook gửi từ SePay (Tùy chọn - chỉ dùng nếu bạn bật xác thực webhook trên SePay)
SEPAY_WEBHOOK_TOKEN=""

# SEPAY_API_KEY (KHÔNG BẮT BUỘC khi chỉ nhận thanh toán qua Webhook).
# Chỉ cần nếu bạn muốn gọi chủ động ra các REST API của SePay (như lấy danh sách transactions/list).
SEPAY_API_KEY=""

# VITE_API_BASE_URL: URL backend công khai khi tách riêng Frontend và Backend
# Mặc định để trống "" nếu frontend và backend chạy cùng domain/port (môi trường dev hoặc Docker container).
# Nếu frontend chạy trên Vercel/Static CDN (ví dụ alps.id.vn) và backend Node.js chạy trên Cloud Run / Server riêng,
# hãy điền URL gốc của backend tại đây (ví dụ: https://api.alps.id.vn).
VITE_API_BASE_URL=""
