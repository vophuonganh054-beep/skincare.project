# Keep existing Gemini key configured in AI Studio.
GEMINI_API_KEY=""
APP_URL=""

# Enable only after the deployment and SePay webhook are configured.
PAYMENTS_ENABLED="false"
# Use the exact MB account linked to SePay, and its real beneficiary name.
SEPAY_ACCOUNT_NUMBER=""
SEPAY_ACCOUNT_NAME=""
# Same key as the API Key authentication setting on the SePay webhook.
# Server only: never use a VITE_ prefix for this value.
SEPAY_WEBHOOK_TOKEN=""

# Defaults below point to the project's existing Firestore database.
FIREBASE_PROJECT_ID="affable-shadow-9smzh"
FIRESTORE_DATABASE_ID="ai-studio-alpsskincarepure-c626102d-74cc-4d1b-8d5b-1b1da414820b"
# On Google Cloud, prefer the runtime service account with Firestore access (ADC).
# Only if ADC is unavailable: put service-account JSON in a SERVER secret, never source code.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Empty when frontend/backend use the same host. For a separate backend, set its
# public HTTPS base URL BEFORE building the frontend.
VITE_API_BASE_URL=""
